# App Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=<generate-with-openssl-rand-base64-32>

# Supabase Configuration
# Get these from: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Database (Optional - for direct PostgreSQL access)
# Get from: Supabase Dashboard → Settings → Database → Connection string → Pooler
DATABASE_URL=postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

# Cron Secret (untuk mengamankan endpoint /api/keep-alive dari akses tidak sah)
# Generate dengan: openssl rand -base64 32
# Tambahkan juga di Vercel Dashboard → Settings → Environment Variables
CRON_SECRET=<generate-with-openssl-rand-base64-32>
